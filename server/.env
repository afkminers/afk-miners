# server/.env
NODE_ENV=development
PORT=3000

JWT_SECRET=dev-change-me-please-1234567890abcdef1234567890abcdef
COOKIE_NAME=sid
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
CSRF_COOKIE=csrf

# Overrides de treino (balance)
TRIES_PER_HIT=1
TRAIN_SWING_SECONDS=2
ENERGY_PER_MIN_WHEN_TRAINING=6
DAILY_TRAIN_CAP_SECONDS=28800   # 8h
MAX_SESSION_SECONDS=43200       # 12h
DEFAULT_START_LEVEL=1
WORKER_TICK_SECONDS=3
