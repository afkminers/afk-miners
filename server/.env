# server/.env

# JWT secret (não compartilhe publicamente)
JWT_SECRET=6e1c84abaaa265175af6c3701a8436fe29550059a24015699ee9a74e78debb2f

# Ambiente
NODE_ENV=development
PORT=3000

# >>> Banco de Dados (Neon Postgres)
# Use sua connection string do Neon SEM o 'psql ' e SEM aspas
# O cliente 'pg' já está configurado no código para usar SSL.
DATABASE_URL=postgresql://neondb_owner:npg_9xznABFv7jbC@ep-fancy-mud-aftv6ea7-pooler.c-2.us-west-2.aws.neon.tech/neondb

# Cookie de sessão oficial (usado pelo middleware/setAuthCookie)
COOKIE_NAME=sid
COOKIE_SECURE=false        # em produção (HTTPS) mude para true
COOKIE_SAME_SITE=Lax       # em produção cross-site pode exigir 'None'
CSRF_COOKIE=csrf

# Redis (se usar chat/presença local)
REDIS_URL=redis://127.0.0.1:6379

# Balance/treino (mantidos)
TRIES_PER_HIT=1
TRAIN_SWING_SECONDS=2
ENERGY_PER_MIN_WHEN_TRAINING=6
DAILY_TRAIN_CAP_SECONDS=28800
MAX_SESSION_SECONDS=43200
DEFAULT_START_LEVEL=1
WORKER_TICK_SECONDS=3

# Pipeline de conteúdo
CONTENT_PIPELINE=on