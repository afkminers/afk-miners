# ===========================
# AFK Miners — .env
# ===========================

# --- Segurança ---
# JWT usado para assinar tokens (NÃO compartilhar)
JWT_SECRET=15dcc600e948e15d796bad392022ff3da33cef7599531b269c36d4402f7a21863eefae795e9cad3ee6c257a0687adcbe
# CSRF usado nos cookies/tokens de sessão
CSRF_SECRET=359174de8fd0bf391b9df96a158bf0ec9240fd6fa494dafd1a89ad4be3e0a8e8d7117ce41025f792251109ef1aa04736

# --- Ambiente / Porta ---
NODE_ENV=development
PORT=3000

# --- Banco de Dados (Neon Postgres) ---
DATABASE_URL=postgresql://neondb_owner:npg_9xznABFv7jbC@ep-fancy-mud-aftv6ea7-pooler.c-2.us-west-2.aws.neon.tech/neondb?sslmode=require
PGSSLMODE=require

# --- pg_dump (para schema perfeito no auto.zip) ---
PG_DUMP_PATH=C:\Users\natha\Documents\postgresql-17.6-1-windows-x64-binaries\pgsql\bin\pg_dump.exe

# --- Cookies / Sessão ---
COOKIE_NAME=sid
SESSION_COOKIE_NAME=sid
COOKIE_SAME_SITE=Lax
CSRF_COOKIE=csrf

# Em DEV (localhost) não força HTTPS, em produção (Render) sim.
COOKIE_SECURE=false

# --- Origens permitidas (CORS/CSRF) ---
# Localhost + domínio público
APP_ORIGINS=http://localhost:3000,https://afkminers.com

# Se quiser cookies também em subdomínios (opcional):
# COOKIE_DOMAIN=.afkminers.com

# --- Redis (opcional, chat/cache) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Balance/treino (skills por HIT, não por tempo) ---
TRIES_PER_HIT=1
TRAIN_SWING_SECONDS=2
ENERGY_PER_MIN_WHEN_TRAINING=6
DAILY_TRAIN_CAP_SECONDS=28800
MAX_SESSION_SECONDS=43200
DEFAULT_START_LEVEL=1
WORKER_TICK_SECONDS=3
TRIES_PER_MINUTE_BASE=60

# --- Loot (itens somem do chão após X segundos) ---
LOOT_EXPIRE_SECONDS=300

# --- Pipeline de conteúdo ---
CONTENT_PIPELINE=on
FEATURE_CHAT_WEBSOCKET=on

# --- Logs ---
LOG_LEVEL=info

# --- Gameplay ---
DEFAULT_MAP_KEY=house
TILE_SIZE=32

# --- Cache estático ---
STATIC_CACHE_SECONDS=30

# --- Context pack (opcional; deixa ligado p/ enriquecer o zip) ---
CTX_SYMBOLS=1
CTX_IMPORTS=1
CTX_DEPTH=4

# --- Database Optimization Features ---
# Endpoint metrics
ENDPOINT_METRICS_INTERVAL_MS=60000
ENDPOINT_METRICS_TOP_N=10
# ENDPOINT_METRICS_PROD=1          # Uncomment for production logging

# Catalog caching
CATALOG_CACHE_ENABLED=1
CATALOG_CACHE_REFRESH_SEC=300
#DEBUG_CATALOG_CACHE=1            # Uncomment for cache debugging

# Idle pool management (test carefully in staging first)
# DB_IDLE_CLOSE_MINUTES=15         # Uncomment to enable auto pool close

# Context generation control
# GEN_CONTEXT_ON_START=1           # Only generate context if explicitly enabled
