# server/.env
# JWT secret gerado
JWT_SECRET=6e1c84abaaa265175af6c3701a8436fe29550059a24015699ee9a74e78debb2f

# Nome do cookie usado pelo auth (routes.js usa process.env.SESSION_COOKIE_NAME || 'token')
SESSION_COOKIE_NAME=token

# Redis URL (para testes locais com Redis rodando na máquina)
REDIS_URL=redis://127.0.0.1:6379

# Ambiente (em produção troque para production)
NODE_ENV=development

PORT=3000

COOKIE_NAME=sid
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
CSRF_COOKIE=csrf

# Overrides de treino (balance)
TRIES_PER_HIT=1
TRAIN_SWING_SECONDS=2
ENERGY_PER_MIN_WHEN_TRAINING=6
DAILY_TRAIN_CAP_SECONDS=28800   # 8h
MAX_SESSION_SECONDS=43200       # 12h
DEFAULT_START_LEVEL=1
WORKER_TICK_SECONDS=3

CONTENT_PIPELINE=on

