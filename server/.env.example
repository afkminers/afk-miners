# AFK Miners — exemplo de .env (NÃO contém segredos reais)

# --- Segurança ---
JWT_SECRET=defina_um_valor_forte_no_deploy
CSRF_SECRET=defina_um_valor_forte_no_deploy
ADMIN_NAMES=tigasfarm141

# --- Ambiente / Porta ---
NODE_ENV=development
PORT=3000

# --- Banco de Dados (Neon Postgres) ---
# Use endpoint -pooler e SSL obrigatório
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-POOLER/neondb?sslmode=require&application_name=afk-miners
PGSSLMODE=require

# Tuning de pool
PGPOOL_MAX=8
PG_IDLE=30000

# --- Caminho do pg_dump (opcional em dev) ---
# PG_DUMP_PATH=/caminho/para/pg_dump

# --- Cookies / Sessão ---
COOKIE_NAME=sid
SESSION_COOKIE_NAME=sid
COOKIE_SAME_SITE=Lax
CSRF_COOKIE=csrf
COOKIE_SECURE=false

# --- Origens permitidas (CORS/CSRF) ---
APP_ORIGINS=http://localhost:3000,https://afkminers.com
# COOKIE_DOMAIN=.afkminers.com

# --- Redis (opcional) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Balance/treino ---
TRIES_PER_HIT=1
TRAIN_SWING_SECONDS=2
ENERGY_PER_MIN_WHEN_TRAINING=6
DAILY_TRAIN_CAP_SECONDS=28800
MAX_SESSION_SECONDS=43200
DEFAULT_START_LEVEL=1
WORKER_TICK_SECONDS=3
TRIES_PER_MINUTE_BASE=60

# --- Loot ---
LOOT_EXPIRE_SECONDS=300

# --- Pipeline de conteúdo ---
CONTENT_PIPELINE=on
FEATURE_CHAT_WEBSOCKET=on

# --- Logs ---
LOG_LEVEL=info

# --- Gameplay ---
DEFAULT_MAP_KEY=house
TILE_SIZE=32

# --- Cache estático (outras partes do app) ---
STATIC_CACHE_SECONDS=30

# --- HTTP Assets Caching ---
# TTL para /api/assets/items e /api/assets/sprites
ASSETS_CACHE_TTL_MS=300000
# DEBUG_HTTP_CACHE=1

# --- Context pack ---
CTX_SYMBOLS=1
CTX_IMPORTS=1
CTX_DEPTH=4

# --- Métricas de endpoint ---
ENDPOINT_METRICS_INTERVAL_MS=60000
ENDPOINT_METRICS_TOP_N=10
# ENDPOINT_METRICS_PROD=1

# --- Catalog caching ---
CATALOG_CACHE_ENABLED=1
CATALOG_CACHE_REFRESH_SEC=300
# DEBUG_CATALOG_CACHE=1

# --- Loot Cache ---
LOOT_CACHE_ENABLED=1
LOOT_CACHE_TTL_SEC=1
# DEBUG_LOOT_CACHE=1

# --- Tick de jogo em dev ---
GAME_TICK_MS=2000

# --- Fechamento automático do pool por inatividade ---
DB_IDLE_CLOSE_MINUTES=15

# --- Idle-aware background task scheduling ---
SYNC_SPAWNS_INTERVAL_MS=300000
IDLE_SCHEDULER_CHECK_MS=30000

# --- Production Migration Controls ---
# SKIP_MIGRATIONS_ON_BOOT=1

# --- Geração de contexto (manual por padrão) ---
# GEN_CONTEXT_ON_START=1